# Local development only. Do not put real secrets in this example file.
POSTGRES_DB=backend_training
DB_USERNAME=backend_app
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD
DB_PORT=5432

APP_PORT=8080

# Generate at least 32 random bytes for the current HS256 JWT implementation.
# Example generation: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_UTF8_BYTES
JWT_EXPIRATION_MS=3600000

# Local development only; Compose validates the schema created by Flyway.
JPA_DDL_AUTO=update

# Optional; leave blank if bootstrap admin is not needed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
